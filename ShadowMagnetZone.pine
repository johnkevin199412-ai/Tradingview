var bool long_tf9 = false, short_tf9 = false
var bool long_tf10 = false, short_tf10 = false

// ———————————————————————— درخواست داده‌های تایم‌فریم‌ها ————————————————————————
[o1, c1, h1, l1] = request.security(syminfo.tickerid, tf1, [open, close, high, low], barmerge.gaps_off, barmerge.lookahead_on)
[o2, c2, h2, l2] = request.security(syminfo.tickerid, tf2, [open, close, high, low], barmerge.gaps_off, barmerge.lookahead_on)
[o3, c3, h3, l3] = request.security(syminfo.tickerid, tf3, [open, close, high, low], barmerge.gaps_off, barmerge.lookahead_on)
