// ———————————————————————— جدول اطلاعات ————————————————————————
var table info = table.new(position.top_right, 2, 11, bgcolor=color.new(color.black, 85), border_width=1)
if bar_index % 10 == 0
    table.cell(info, 0, 0, "تایم‌فریم", bgcolor=color.gray, text_color=color.white)
    table.cell(info, 1, 0, "سیگنال", bgcolor=color.gray, text_color=color.white)

    table.cell(info, 0, 1, "TF1", text_color=enable_tf1 ? color.white : color.gray)
    table.cell(info, 1, 1, long_tf1 ? "لانگ" : short_tf1 ? "شورت" : "خنثی", text_color=long_tf1?color.green:short_tf1?color.red:color.gray)

    table.cell(info, 0, 2, "TF2", text_color=enable_tf2 ? color.white : color.gray)
    table.cell(info, 1, 2, long_tf2 ? "لانگ" : short_tf2 ? "شورت" : "خنثی", text_color=long_tf2?color.lime:short_tf2?color.maroon:color.gray)

    table.cell(info, 0, 3, "TF3", text_color=enable_tf3 ? color.white : color.gray)
    table.cell(info, 1, 3, long_tf3 ? "لانگ" : short_tf3 ? "شورت" : "خنثی", text_color=long_tf3?color.teal:short_tf3?color.purple:color.gray)

    table.cell(info, 0, 4, "TF4", text_color=enable_tf4 ? color.white : color.gray)
    table.cell(info, 1, 4, long_tf4 ? "لانگ" : short_tf4 ? "شورت" : "خنثی", text_color=long_tf4?color.blue:short_tf4?color.orange:color.gray)

    table.cell(info, 0, 5, "TF5", text_color=enable_tf5 ? color.white : color.gray)
    table.cell(info, 1, 5, long_tf5 ? "لانگ" : short_tf5 ? "شورت" : "خنثی", text_color=long_tf5?color.aqua:short_tf5?color.fuchsia:color.gray)

    table.cell(info, 0, 6, "TF6", text_color=enable_tf6 ? color.white : color.gray)
