[o8, c8, h8, l8] = request.security(syminfo.tickerid, tf8, [open, close, high, low], barmerge.gaps_off, barmerge.lookahead_on)
[o9, c9, h9, l9] = request.security(syminfo.tickerid, tf9, [open, close, high, low], barmerge.gaps_off, barmerge.lookahead_on)
[o10, c10, h10, l10] = request.security(syminfo.tickerid, tf10, [open, close, high, low], barmerge.gaps_off, barmerge.lookahead_on)

// ———————————————————————— پردازش تایم‌فریم ۱ ————————————————————————
if enable_tf1
    f_find_zones(o1, c1, h1, l1, zone_lookback_tf1, min_zone_strength_tf1, "TF1", demand_zones_tf1, supply_zones_tf1, max_zone_age_tf1)
    f_manage_flip_zones(enable_flip_zones, c1, demand_zones_tf1, supply_zones_tf1, flip_zones_tf1, max_zone_age_tf1, "TF1", flip_extend_bars, flip_supply_color, flip_demand_color)
    [u1, l1_sum] = f_shadow_sum(o1, c1, h1, l1, lookback1_tf1, lookback2_tf1, lookback3_tf1, body_lookback_tf1, min_body_ratio_tf1, max_body_ratio_tf1)

    in_demand_tf1 = false
    in_supply_tf1 = false
    for b in demand_zones_tf1
        if low <= box.get_top(b) and high >= box.get_bottom(b)
            in_demand_tf1 := true
    for b in supply_zones_tf1
        if high >= box.get_bottom(b) and low <= box.get_top(b)
            in_supply_tf1 := true

    bullish_tf1 = l1_sum > u1
    bearish_tf1 = u1 > l1_sum

    long_tf1 := bullish_tf1 and in_demand_tf1
    short_tf1 := bearish_tf1 and in_supply_tf1
else
    long_tf1 := false
    short_tf1 := false

