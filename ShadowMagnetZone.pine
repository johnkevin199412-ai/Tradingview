var box[] supply_zones_tf4 = array.new_box()
var box[] flip_zones_tf4   = array.new_box()
var box[] demand_zones_tf5 = array.new_box()
var box[] supply_zones_tf5 = array.new_box()
var box[] flip_zones_tf5   = array.new_box()
