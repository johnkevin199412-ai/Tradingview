var box[] demand_zones_tf8 = array.new_box()
var box[] supply_zones_tf8 = array.new_box()
var box[] flip_zones_tf8   = array.new_box()
var box[] demand_zones_tf9 = array.new_box()
var box[] supply_zones_tf9 = array.new_box()
var box[] flip_zones_tf9   = array.new_box()
var box[] demand_zones_tf10 = array.new_box()
var box[] supply_zones_tf10 = array.new_box()
var box[] flip_zones_tf10   = array.new_box()

// ———————————————————————— متغیرهای سیگنال ————————————————————————
var bool long_tf1 = false, short_tf1 = false
var bool long_tf2 = false, short_tf2 = false
var bool long_tf3 = false, short_tf3 = false
var bool long_tf4 = false, short_tf4 = false
var bool long_tf5 = false, short_tf5 = false
var bool long_tf6 = false, short_tf6 = false
var bool long_tf7 = false, short_tf7 = false
