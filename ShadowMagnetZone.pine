max_zone_age_tf10 = input.int(14, "حداکثر عمر ناحیه (TF10)", minval=1, group="تنظیمات TF10")

// ———————————————————————— تابع محاسبه سایه‌ها ————————————————————————
f_shadow_sum(_src_o, _src_c, _src_h, _src_l, _lookback1, _lookback2, _lookback3, _body_lookback, _min_body, _max_body) =>
    upper_sum = 0.0
    lower_sum = 0.0
    max_lookback = math.max(_lookback1, math.max(_lookback2, _lookback3))
    if bar_index <= max_lookback
        [upper_sum, lower_sum]
    lens = array.from(_lookback1, _lookback2, _lookback3)
    for len in lens
        for i = 1 to len
            if bar_index <= i
                continue
            o = _src_o[i]
            c = _src_c[i]
            h = _src_h[i]
            l = _src_l[i]
            body = math.abs(c - o)
            upper_shadow = h - math.max(o, c)
            lower_shadow = math.min(o, c) - l
            sum_body = 0.0
            for j = 1 to _body_lookback
                idx = i + j
                if idx < bar_index
                    sum_body += math.abs(_src_c[idx] - _src_o[idx])
            avg_body = _body_lookback > 0 ? sum_body / _body_lookback : 1
            if body >= _min_body * avg_body and body <= _max_body * avg_body and body > 0
                upper_sum += upper_shadow
                lower_sum += lower_shadow
    [upper_sum, lower_sum]

// ———————————————————————— تابع تشخیص ناحیه ————————————————————————
f_find_zones(_src_o, _src_c, _src_h, _src_l, _zone_lookback, _min_strength, _tf_label, _demand_boxes, _supply_boxes, _max_zone_age) =>
    while array.size(_demand_boxes) > 0
        b = array.get(_demand_boxes, array.size(_demand_boxes) - 1)
        if bar_index - box.get_left(b) > _max_zone_age
            box.delete(b)
            array.pop(_demand_boxes)
        else
            break
    while array.size(_supply_boxes) > 0
        b = array.get(_supply_boxes, array.size(_supply_boxes) - 1)
        if bar_index - box.get_left(b) > _max_zone_age
            box.delete(b)
            array.pop(_supply_boxes)
        else
            break
    if bar_index > _zone_lookback + 1
        base_o = _src_o[_zone_lookback]
        base_c = _src_c[_zone_lookback]
        base_h = _src_h[_zone_lookback]
        base_l = _src_l[_zone_lookback]
        base_body = math.abs(base_c - base_o)
        trigger_l = _src_l[1]
        trigger_h = _src_h[1]
        if base_l > trigger_l and (base_h - trigger_l) >= _min_strength * base_body
            top_zone = base_l
            bot_zone = math.min(base_l, trigger_l)
            new_box = box.new(left=bar_index - _zone_lookback, top=top_zone, right=bar_index + 20, bottom=bot_zone, bgcolor=color.new(color.green, 90), border_color=color.green, text="D\n"+_tf_label)
            array.push(_demand_boxes, new_box)
        if base_h < trigger_h and (trigger_h - base_l) >= _min_strength * base_body
            top_zone = trigger_h
            bot_zone = base_h
            new_box = box.new(left=bar_index - _zone_lookback, top=top_zone, right=bar_index + 20, bottom=bot_zone, bgcolor=color.new(color.red, 90), border_color=color.red, text="S\n"+_tf_label)
            array.push(_supply_boxes, new_box)

// ———————————————————————— تابع مدیریت نواحی Flip ————————————————————————
f_manage_flip_zones(_enabled, _src_c, _demand_boxes, _supply_boxes, _flip_boxes, _max_zone_age, _tf_label, _extend, _flip_supply_color, _flip_demand_color) =>
    if not _enabled
        while array.size(_flip_boxes) > 0
            box.delete(array.pop(_flip_boxes))
        return
    idx = array.size(_flip_boxes) - 1
    while idx >= 0
        b = array.get(_flip_boxes, idx)
        if bar_index - box.get_left(b) > _max_zone_age
            box.delete(b)
            array.remove(_flip_boxes, idx)
        idx -= 1
    if na(_src_c) or na(_src_c[1])
        return
    idx = array.size(_demand_boxes) - 1
    while idx >= 0
        b = array.get(_demand_boxes, idx)
        zone_top = box.get_top(b)
        zone_bot = box.get_bottom(b)
        if _src_c < zone_bot and _src_c[1] >= zone_bot
            array.remove(_demand_boxes, idx)
            box.delete(b)
            new_box = box.new(left=bar_index, top=zone_top, right=bar_index + _extend, bottom=zone_bot, bgcolor=_flip_supply_color, border_color=color.new(_flip_supply_color, 0), text="Flip S\n"+_tf_label)
            array.push(_flip_boxes, new_box)
        idx -= 1
    idx = array.size(_supply_boxes) - 1
    while idx >= 0
        b = array.get(_supply_boxes, idx)
        zone_top = box.get_top(b)
        zone_bot = box.get_bottom(b)
        if _src_c > zone_top and _src_c[1] <= zone_top
            array.remove(_supply_boxes, idx)
            box.delete(b)
            new_box = box.new(left=bar_index, top=zone_top, right=bar_index + _extend, bottom=zone_bot, bgcolor=_flip_demand_color, border_color=color.new(_flip_demand_color, 0), text="Flip D\n"+_tf_label)
            array.push(_flip_boxes, new_box)
        idx -= 1

// ———————————————————————— آرایه‌های نواحی ————————————————————————
var box[] demand_zones_tf1 = array.new_box()
var box[] supply_zones_tf1 = array.new_box()
var box[] flip_zones_tf1   = array.new_box()
var box[] demand_zones_tf2 = array.new_box()
var box[] supply_zones_tf2 = array.new_box()
var box[] flip_zones_tf2   = array.new_box()
