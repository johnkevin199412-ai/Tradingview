//@version=6
indicator("Shadow Precision SR", overlay = true, max_lines_count = 200, max_labels_count = 50)

// ─────────────── Inputs ───────────────
groupShadow  = "Shadow Bias"
wickLen      = input.int(5, "Shadow smoothing", minval = 1, group = groupShadow)
wickMethod   = input.string("EMA", "Smoothing type", options = ["EMA", "SMA", "RMA"], group = groupShadow)
dominancePct = input.float(15, "Dominance threshold (%)", step = 0.5, group = groupShadow) * 0.01
bodyAtrMin   = input.float(0.35, "Min body size (x ATR)", step = 0.05, group = groupShadow)
atrLen       = input.int(14, "ATR length", minval = 1, group = groupShadow)

groupSR      = "Level Engine"
pivotLeft    = input.int(3, "Pivot left", minval = 1, group = groupSR)
pivotRight   = input.int(3, "Pivot right", minval = 1, group = groupSR)
maxLevels    = input.int(4, "Max stored levels", minval = 1, maxval = 10, group = groupSR)
lineHistory  = input.int(200, "Line lookback", minval = 10, group = groupSR)
spacingPct   = input.float(0.4, "Min spacing (%)", step = 0.05, group = groupSR) * 0.01
touchPct     = input.float(0.3, "Touch tolerance (%)", step = 0.05, group = groupSR) * 0.01
levelMaxAge  = input.int(600, "Max level age (bars)", minval = 10, group = groupSR)

groupFilter  = "Precision Filters"
useTrend     = input.bool(true, "Use HTF trend filter", group = groupFilter)
trendTf      = input.timeframe("60", "Trend timeframe", group = groupFilter)
trendLen     = input.int(50, "Trend EMA length", minval = 1, group = groupFilter)
atrTouchMult = input.float(0.65, "ATR touch multiplier", step = 0.05, minval = 0, group = groupFilter)
useRejection = input.bool(true, "Require rejection candle", group = groupFilter)
rejectionMin = input.float(1.3, "Shadow/body ratio", step = 0.1, minval = 0, group = groupFilter)

groupDisplay = "Display"
highlightMode = input.string("Both", "Background highlight", options = ["Both", "Long only", "Short only", "Off"], group = groupDisplay)
showLines      = input.bool(true, "Show support / resistance lines", group = groupDisplay)

// ─────────────── Helpers ───────────────
f_smooth(src) =>
    wickMethod == "SMA" ? ta.sma(src, wickLen) :
    wickMethod == "RMA" ? ta.rma(src, wickLen) : ta.ema(src, wickLen)

f_prune(float[] prices, line[] lines, int[] bars) =>
    for i = array.size(prices) - 1 to 0
        bool stale = bar_index - array.get(bars, i) > levelMaxAge
        if stale
            line ln = array.remove(lines, i)
            line.delete(ln)
            array.remove(prices, i)
            array.remove(bars, i)

f_refresh(float[] prices, int[] bars, line[] lines, color col) =>
    if showLines
        int count = math.min(array.size(prices), math.min(array.size(bars), array.size(lines)))
        for i = 0 to count - 1
            float price = array.get(prices, i)
            int pivotBar = array.get(bars, i)
            line ln = array.get(lines, i)
            int anchor = math.max(pivotBar, bar_index - lineHistory)
            line.set_xy1(ln, anchor, price)
            line.set_xy2(ln, bar_index, price)
            line.set_extend(ln, extend.right)
            line.set_color(ln, col)
    else
        for i = array.size(lines) - 1 to 0
            line ln = array.remove(lines, i)
            line.delete(ln)

f_addLevel(float levelPrice, int pivotBarIndex, float[] prices, line[] lines, int[] bars, color col) =>
    bool tooClose = false
    for i = 0 to array.size(prices) - 1
        float existing = array.get(prices, i)
        if math.abs(existing - levelPrice) / levelPrice <= spacingPct
            tooClose := true
    if not tooClose
        if array.size(prices) >= maxLevels
            line ln = array.pop(lines)
            line.delete(ln)
            array.pop(prices)
            array.pop(bars)
        array.unshift(prices, levelPrice)
        array.unshift(bars, pivotBarIndex)
        line lnNew = line.new(pivotBarIndex, levelPrice, pivotBarIndex + 1, levelPrice, extend = extend.right, color = col, style = line.style_dashed)
        array.unshift(lines, lnNew)

f_touch(float[] prices, float pctTol, float absTol) =>
    float nearest = na
    float bestDist = na
    bool hit = false
    for i = 0 to array.size(prices) - 1
        float level = array.get(prices, i)
        float dist = math.abs(close - level)
        float pct = math.abs(close - level) / close
        bool within = pct <= pctTol or (absTol > 0 and dist <= absTol)
        if within and (na(bestDist) or dist < bestDist)
            bestDist := dist
            nearest := level
            hit := true
    [nearest, hit]

// ─────────────── Shadow bias & filters ───────────────
float upperShadow = high - math.max(open, close)
float lowerShadow = math.min(open, close) - low
float avgUpper    = f_smooth(upperShadow)
float avgLower    = f_smooth(lowerShadow)
float wickSum     = avgUpper + avgLower
float dominance   = wickSum == 0 ? 0 : (avgUpper - avgLower) / wickSum

float atr = ta.atr(atrLen)
float body = math.abs(close - open)
bool strongBody = atr == 0 ? true : body >= atr * bodyAtrMin
float atrBand = atr * atrTouchMult

bool longBias  = strongBody and avgLower > avgUpper * (1 + dominancePct)
bool shortBias = strongBody and avgUpper > avgLower * (1 + dominancePct)

bool longReject  = not useRejection or (close > open and lowerShadow >= body * rejectionMin)
bool shortReject = not useRejection or (close < open and upperShadow >= body * rejectionMin)

float trendSeries = request.security(syminfo.tickerid, trendTf, ta.ema(close, trendLen), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
bool trendLong  = not useTrend or close >= trendSeries
bool trendShort = not useTrend or close <= trendSeries

// ─────────────── Level engine ───────────────
var float[] resPrices = array.new_float()
var float[] supPrices = array.new_float()
var line[]  resLines  = array.new_line()
var line[]  supLines  = array.new_line()
var int[]   resBars   = array.new_int()
var int[]   supBars   = array.new_int()

float ph = ta.pivothigh(high, pivotLeft, pivotRight)
if not na(ph)
    f_addLevel(ph, bar_index - pivotRight, resPrices, resLines, resBars, color.new(color.red, 20))
float pl = ta.pivotlow(low, pivotLeft, pivotRight)
if not na(pl)
    f_addLevel(pl, bar_index - pivotRight, supPrices, supLines, supBars, color.new(color.lime, 20))

f_prune(resPrices, resLines, resBars)
f_prune(supPrices, supLines, supBars)
f_refresh(resPrices, resBars, resLines, color.new(color.red, 25))
f_refresh(supPrices, supBars, supLines, color.new(color.lime, 25))

[nearestRes, nearRes] = f_touch(resPrices, touchPct, atrBand)
[nearestSup, nearSup] = f_touch(supPrices, touchPct, atrBand)

// ─────────────── Signals ───────────────
bool longSignal  = longBias and longReject and nearSup and trendLong and not shortBias
bool shortSignal = shortBias and shortReject and nearRes and trendShort and not longBias

color longBg  = color.new(color.lime, 85)
color shortBg = color.new(color.red, 85)
bool paintLong = longSignal and (highlightMode == "Both" or highlightMode == "Long only")
bool paintShort = shortSignal and (highlightMode == "Both" or highlightMode == "Short only")
bgcolor(highlightMode == "Off" ? na : paintLong ? longBg : paintShort ? shortBg : na)

plotshape(longSignal, "Shadow Long", style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.large, text = "LONG", textcolor = color.white)
plotshape(shortSignal, "Shadow Short", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.large, text = "SHORT", textcolor = color.white)

plot(nearestSup, "Nearest support", display = display.data_window, color = color.new(color.lime, 0))
plot(nearestRes, "Nearest resistance", display = display.data_window, color = color.new(color.red, 0))
plot(trendSeries, "Trend EMA", display = display.data_window, color = color.new(color.blue, 0))
plot(dominance, "Shadow dominance", display = display.data_window, color = color.new(color.gray, 0))

alertcondition(longSignal, "Shadow Long", "Lower wicks dominant + rejection near support")
alertcondition(shortSignal, "Shadow Short", "Upper wicks dominant + rejection near resistance")
