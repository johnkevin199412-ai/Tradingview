//@version=5
indicator("Body Range Scanner", overlay=false, max_lines_count=500, max_labels_count=500)

// ——— Inputs ———
tf_input       = input.timeframe("60", "Source timeframe")
lookback       = input.int(20, "Candles to scan (X)", minval=1, maxval=500)
avg_window     = input.int(5, "Average body window (Y)", minval=1, maxval=200)
min_avg_body   = input.float(0.20, "Min average body (M)", step=0.01, minval=0)
max_avg_body   = input.float(5.00, "Max average body (N)", step=0.01, minval=0.01)

// ——— Fetch HTF data ———
[open_tf, high_tf, low_tf, close_tf] = request.security(syminfo.tickerid, tf_input, [open, high, low, close], lookahead=barmerge.lookahead_on)

// ——— Candle anatomy ———
body_size  = math.abs(close_tf - open_tf)
upper_wick = high_tf - math.max(open_tf, close_tf)
lower_wick = math.min(open_tf, close_tf) - low_tf

avg_body = ta.sma(body_size, avg_window)
qualifies = not na(avg_body) and avg_body >= min_avg_body and avg_body <= max_avg_body

qualified_count = lookback * ta.sma(qualifies ? 1.0 : 0.0, lookback)

plot(body_size, title="Body size", color=color.rgb(0, 149, 255))
plot(upper_wick, title="Upper shadow", color=color.rgb(44, 186, 0))
plot(lower_wick, title="Lower shadow", color=color.rgb(230, 122, 34))
plot(qualified_count, title="Qualified candles in lookback", color=color.white, style=plot.style_columns)

plotshape(qualifies, title="Qualified candle", style=shape.triangleup, color=color.rgb(247, 209, 52), location=location.bottom, size=size.tiny, text="Q")

// ——— Summary table ———
var stats_table = table.new(position.top_right, 2, 5, border_color=color.new(color.gray, 70))
if barstate.islast
    table.cell(stats_table, 0, 0, "Metric", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(stats_table, 1, 0, "Value", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(stats_table, 0, 1, "Body size", text_color=color.rgb(0, 149, 255))
    table.cell(stats_table, 1, 1, str.tostring(body_size, format.mintick))
    table.cell(stats_table, 0, 2, "Upper shadow", text_color=color.rgb(44, 186, 0))
    table.cell(stats_table, 1, 2, str.tostring(upper_wick, format.mintick))
    table.cell(stats_table, 0, 3, "Lower shadow", text_color=color.rgb(230, 122, 34))
    table.cell(stats_table, 1, 3, str.tostring(lower_wick, format.mintick))
    table.cell(stats_table, 0, 4, "Qualifying (X)", text_color=color.white)
    table.cell(stats_table, 1, 4, str.tostring(qualified_count, "#"))
