//@version=6
indicator("Wick Pressure Signals", overlay=true)

//––––– Core inputs
lenCalc       = input.int(14, "تعداد کندل بررسی", minval=1)
bodyAvgLen    = input.int(10, "C: طول میانگین بدنه", minval=1)
bodyMinFactor = input.float(0.8, "A: حداقل نسبت به میانگین", step=0.1, minval=0.0)
bodyMaxFactor = input.float(1.2, "B: حداکثر نسبت به میانگین", step=0.1, minval=0.0)

//––––– Timeframe selection
useTf1 = input.bool(true,  "فعال‌سازی تایم فریم 1")
tf1    = input.timeframe("60",  "تایم فریم 1")
useTf2 = input.bool(true,  "فعال‌سازی تایم فریم 2")
tf2    = input.timeframe("240", "تایم فریم 2")
useTf3 = input.bool(false, "فعال‌سازی تایم فریم 3")
tf3    = input.timeframe("1D",  "تایم فریم 3")

showTfLines = input.bool(false, "نمایش خطوط هر تایم‌فریم در پنل")

//––––– Panel placement inputs
atrLenPanel = input.int(14, "طول ATR برای پنل", minval=1)
panelGapATR = input.float(1.5, "فاصله پنل (ضریب ATR)", minval=0.1)
panelHATR   = input.float(2.5, "ارتفاع پنل (ضریب ATR)", minval=0.5)

// Utility: calculate normalized wick sums for a timeframe
calcNormalizedWicks(tf) =>
    o_tf = request.security(syminfo.tickerid, tf, open)
    h_tf = request.security(syminfo.tickerid, tf, high)
    l_tf = request.security(syminfo.tickerid, tf, low)
    c_tf = request.security(syminfo.tickerid, tf, close)
    bodySize     = math.abs(o_tf - c_tf)
    avgBodyPrior = ta.sma(bodySize, bodyAvgLen)[1]
    bodyCond     = not na(avgBodyPrior) and avgBodyPrior > 0 and
                   bodySize >= avgBodyPrior * bodyMinFactor and
                   bodySize <= avgBodyPrior * bodyMaxFactor
    upperWick    = bodyCond ? h_tf - math.max(o_tf, c_tf) : 0.0
    lowerWick    = bodyCond ? math.min(o_tf, c_tf) - l_tf : 0.0
    sumUpper     = ta.sma(upperWick, lenCalc) * lenCalc
    sumLower     = ta.sma(lowerWick, lenCalc) * lenCalc
    total        = sumUpper + sumLower
    normUpper    = total > 0 ? sumUpper / total : na
    normLower    = total > 0 ? sumLower / total : na
    [normUpper, normLower]

// Fetch normalized contributions per timeframe
[tf1Upper, tf1Lower] = calcNormalizedWicks(tf1)
[tf2Upper, tf2Lower] = calcNormalizedWicks(tf2)
[tf3Upper, tf3Lower] = calcNormalizedWicks(tf3)

// Combine active timeframes by averaging normalized values
float combinedUpper = 0.0
float combinedLower = 0.0
int   activeCount   = 0

addContribution(enabled, upperVal, lowerVal) =>
    upperContribution = nz(upperVal)
    lowerContribution = nz(lowerVal)
    isValid = enabled and not na(upperVal) and not na(lowerVal)
    [upperContribution, lowerContribution, isValid ? 1 : 0]

[tf1ContribUp, tf1ContribDown, tf1Active] = addContribution(useTf1, tf1Upper, tf1Lower)
[tf2ContribUp, tf2ContribDown, tf2Active] = addContribution(useTf2, tf2Upper, tf2Lower)
[tf3ContribUp, tf3ContribDown, tf3Active] = addContribution(useTf3, tf3Upper, tf3Lower)

combinedUpper += tf1Active == 1 ? tf1ContribUp : 0
combinedUpper += tf2Active == 1 ? tf2ContribUp : 0
combinedUpper += tf3Active == 1 ? tf3ContribUp : 0

combinedLower += tf1Active == 1 ? tf1ContribDown : 0
combinedLower += tf2Active == 1 ? tf2ContribDown : 0
combinedLower += tf3Active == 1 ? tf3ContribDown : 0

activeCount += tf1Active
activeCount += tf2Active
activeCount += tf3Active

combinedUpper := activeCount > 0 ? combinedUpper / activeCount : na
combinedLower := activeCount > 0 ? combinedLower / activeCount : na

// Signal logic on combined normalized values
longSignal  = not na(combinedUpper) and not na(combinedLower) and combinedLower > combinedUpper
shortSignal = not na(combinedUpper) and not na(combinedLower) and combinedUpper > combinedLower

plotshape(longSignal,  title="Long",  style=shape.triangleup,   color=color.new(color.lime, 0),
          location=location.belowbar, size=size.tiny, text="Long")
plotshape(shortSignal, title="Short", style=shape.triangledown, color=color.new(color.red, 0),
          location=location.abovebar, size=size.tiny, text="Short")

// Panel anchored under price for combined lines
atrBase    = ta.atr(atrLenPanel)
panelUpper = low - atrBase * panelGapATR
panelLower = panelUpper - atrBase * panelHATR
panelRange = panelUpper - panelLower

panelValue(val) =>
    panelRange > 0 and not na(val) ? panelLower + val * panelRange : na

upperBoundPlot = plot(panelUpper, title="Panel Upper Bound", display=display.none)
lowerBoundPlot = plot(panelLower, title="Panel Lower Bound", display=display.none)
fill(upperBoundPlot, lowerBoundPlot, color=color.new(color.gray, 90))

plot(panelValue(combinedUpper), "Combined Upper Wick", color=color.new(color.red, 0), linewidth=2)
plot(panelValue(combinedLower), "Combined Lower Wick", color=color.new(color.green, 0), linewidth=2)

// Optional display of each timeframe's normalized lines
plot(showTfLines ? panelValue(tf1Upper) : na, "TF1 Upper", color=color.new(color.red, 70), linewidth=1)
plot(showTfLines ? panelValue(tf1Lower) : na, "TF1 Lower", color=color.new(color.green, 70), linewidth=1)
plot(showTfLines ? panelValue(tf2Upper) : na, "TF2 Upper", color=color.new(color.orange, 70), linewidth=1)
plot(showTfLines ? panelValue(tf2Lower) : na, "TF2 Lower", color=color.new(color.teal, 70), linewidth=1)
plot(showTfLines ? panelValue(tf3Upper) : na, "TF3 Upper", color=color.new(color.purple, 70), linewidth=1)
plot(showTfLines ? panelValue(tf3Lower) : na, "TF3 Lower", color=color.new(color.blue, 70), linewidth=1)
