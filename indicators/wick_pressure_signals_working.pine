//@version=6
indicator("Wick Pressure Signals", overlay=true, max_labels_count=500, max_lines_count=500)

//––––– Base inputs
tfCalc        = input.timeframe("60",  "تایم‌فریم محاسبه")
lenCalc       = input.int(14,         "تعداد کندل بررسی",       minval=1)
bodyAvgLen    = input.int(10,         "C: طول میانگین بدنه",    minval=1)
bodyMinFactor = input.float(0.8,      "A: حداقل نسبت به میانگین", step=0.1, minval=0.0)
bodyMaxFactor = input.float(1.2,      "B: حداکثر نسبت به میانگین", step=0.1, minval=0.0)

//––––– Optional modifiers
useVolWeight     = input.bool(false, "وزن‌دهی سایه با حجم")
volSmoothLen     = input.int(20,     "طول میانگین حجم", minval=1)
useTrendFilter   = input.bool(false, "فیلتر EMA روی تایم چارت")
trendEmaLen      = input.int(50,     "طول EMA فیلتر",   minval=1)
useHigherConfirm = input.bool(false, "تایید جهت از تایم بالاتر")
confirmTf        = input.timeframe("240", "تایم‌فریم تایید")
confirmEmaLen    = input.int(34, "طول EMA تایم بالاتر", minval=1)
useSessionFilter = input.bool(false, "فعال‌سازی فیلتر سشن")
sessionWindow    = input.session("0000-2359", "بازه سشن مجاز")
useCoverageGuard = input.bool(false, "حداقل درصد کندل معتبر")
coverageLookback = input.int(20, "طول محاسبه پوشش", minval=1)
coverageMinPct   = input.float(40, "حداقل پوشش (%)", minval=0, maxval=100)
normalizeByATR   = input.bool(false, "نرمال‌سازی سایه بر اساس ATR تایم محاسبه")
atrNormLen       = input.int(14, "طول ATR نرمال‌سازی", minval=1)

//––––– Panel + visualization inputs
atrLenPanel   = input.int(14,         "طول ATR برای پنل",       minval=1)
panelGapATR   = input.float(1.5,      "فاصله پنل (ضریب ATR)",  minval=0.1)
panelHATR     = input.float(2.5,      "ارتفاع پنل (ضریب ATR)", minval=0.5)

showTargets   = input.bool(false, "نمایش هدف/استاپ داینامیک")
targetAtrLen  = input.int(14,    "طول ATR اهداف", minval=1)
tpMultiplier  = input.float(2.0, "ضریب ATR تارگت", minval=0.1)
slMultiplier  = input.float(1.0, "ضریب ATR استاپ", minval=0.1)

enableAlerts  = input.bool(true,  "فعالسازی هشدار سیگنال‌ها")

showStatsPanel = input.bool(false, "نمایش آمار برد/باخت")
statsLookahead = input.int(8,      "حداکثر تعداد کندل برای ارزیابی", minval=1)
statsAtrMult   = input.float(1.0,  "ضریب ATR برای آمار", minval=0.1)

//––––– Higher timeframe series
o = request.security(syminfo.tickerid, tfCalc, open)
h = request.security(syminfo.tickerid, tfCalc, high)
l = request.security(syminfo.tickerid, tfCalc, low)
c = request.security(syminfo.tickerid, tfCalc, close)
v = request.security(syminfo.tickerid, tfCalc, volume)

// Session condition on HTF candles
tfSessionOk = request.security(syminfo.tickerid, tfCalc, session.issession(sessionWindow))
sessionCond = not useSessionFilter or (tfSessionOk == 1)

// Body filter based on average body length
bodySize     = math.abs(o - c)
avgBodyPrior = ta.sma(bodySize, bodyAvgLen)[1]
bodyCond     = not na(avgBodyPrior) and avgBodyPrior > 0 and
               bodySize >= avgBodyPrior * bodyMinFactor and
               bodySize <= avgBodyPrior * bodyMaxFactor
validBody    = bodyCond and sessionCond

// Coverage guard (percentage of valid candles in lookback)
validCounter = ta.sma(validBody ? 1.0 : 0.0, coverageLookback) * coverageLookback
coveragePct  = coverageLookback > 0 ? (validCounter / coverageLookback) * 100.0 : 100.0
coverageCond = not useCoverageGuard or coveragePct >= coverageMinPct

// Volume weighting
volAvg    = ta.sma(v, volSmoothLen)
volWeight = useVolWeight and not na(volAvg) and volAvg > 0 ? v / volAvg : 1.0

// ATR normalization (HTF)
atrNormSeries = normalizeByATR ? request.security(syminfo.tickerid, tfCalc, ta.atr(atrNormLen)) : na
atrNormFactor = normalizeByATR and not na(atrNormSeries) and atrNormSeries > 0 ? atrNormSeries : 1.0

// Wick calculations gated by body & session filters
upperWickRaw = h - math.max(o, c)
lowerWickRaw = math.min(o, c) - l
upperWick    = validBody ? (upperWickRaw / atrNormFactor) * volWeight : 0.0
lowerWick    = validBody ? (lowerWickRaw / atrNormFactor) * volWeight : 0.0

sumUpper = ta.sma(upperWick, lenCalc) * lenCalc
sumLower = ta.sma(lowerWick, lenCalc) * lenCalc

// Base signals from wick pressure
longSignalBase  = coverageCond and sumLower > sumUpper
shortSignalBase = coverageCond and sumUpper > sumLower

// Trend filter on chart timeframe
emaTrend = ta.ema(close, trendEmaLen)
trendCondLong  = not useTrendFilter or close > emaTrend
trendCondShort = not useTrendFilter or close < emaTrend

// Higher timeframe confirmation
htfClose = request.security(syminfo.tickerid, confirmTf, close)
htfEma   = request.security(syminfo.tickerid, confirmTf, ta.ema(close, confirmEmaLen))
htfCondLong  = not useHigherConfirm or htfClose > htfEma
htfCondShort = not useHigherConfirm or htfClose < htfEma

longSignalFinal  = longSignalBase  and trendCondLong  and htfCondLong
shortSignalFinal = shortSignalBase and trendCondShort and htfCondShort

plotshape(longSignalFinal,  title="Long",  style=shape.triangleup,   color=color.new(color.lime, 0),
          location=location.belowbar, size=size.tiny, text="Long")
plotshape(shortSignalFinal, title="Short", style=shape.triangledown, color=color.new(color.red, 0),
          location=location.abovebar, size=size.tiny, text="Short")

// Optional target/stop guide
atrTargets = ta.atr(targetAtrLen)
var float longTpLine  = na
var float longSlLine  = na
var float shortTpLine = na
var float shortSlLine = na

longTpLine  := showTargets ? (longSignalFinal  ? close + atrTargets * tpMultiplier : nz(longTpLine[1]))  : na
longSlLine  := showTargets ? (longSignalFinal  ? close - atrTargets * slMultiplier : nz(longSlLine[1]))  : na
shortTpLine := showTargets ? (shortSignalFinal ? close - atrTargets * tpMultiplier : nz(shortTpLine[1])) : na
shortSlLine := showTargets ? (shortSignalFinal ? close + atrTargets * slMultiplier : nz(shortSlLine[1])) : na

plot(longTpLine,  "Long TP",  color=color.new(color.green, 0), linewidth=1, style=plot.style_linebr)
plot(longSlLine,  "Long SL",  color=color.new(color.red,   0), linewidth=1, style=plot.style_linebr)
plot(shortTpLine, "Short TP", color=color.new(color.green, 0), linewidth=1, style=plot.style_linebr)
plot(shortSlLine, "Short SL", color=color.new(color.red,   0), linewidth=1, style=plot.style_linebr)

// Floating panel beneath price for wick sums
atrBase      = ta.atr(atrLenPanel)
panelUpper   = low - atrBase * panelGapATR
panelLower   = panelUpper - atrBase * panelHATR
panelRange   = panelUpper - panelLower
maxSum       = math.max(sumUpper, sumLower)
safeDivisor  = maxSum > 0 ? maxSum : 1e-6
normUpper    = panelRange > 0 ? panelLower + (sumUpper / safeDivisor) * panelRange : na
normLower    = panelRange > 0 ? panelLower + (sumLower / safeDivisor) * panelRange : na

upperBoundPlot = plot(panelUpper, title="Panel Upper Bound", display=display.none)
lowerBoundPlot = plot(panelLower, title="Panel Lower Bound", display=display.none)
fill(upperBoundPlot, lowerBoundPlot, color=color.new(color.gray, 90))

plot(normUpper, title="Upper Wick Sum (panel)", color=color.new(color.red, 0),   linewidth=2)
plot(normLower, title="Lower Wick Sum (panel)", color=color.new(color.green, 0), linewidth=2)

// Alerts
alertcondition(enableAlerts and longSignalFinal,  title="Wick Long",  message="Wick Pressure: Long signal")
alertcondition(enableAlerts and shortSignalFinal, title="Wick Short", message="Wick Pressure: Short signal")

// Simple performance stats
var int wins       = 0
var int losses     = 0
var bool tradeLive = false
var int tradeDir   = 0
var float tradeEntry  = na
var float tradeTarget = na
var float tradeStop   = na
var int tradeBarsLeft = 0

if not showStatsPanel and tradeLive
    tradeLive := false
    tradeDir := 0

if showStatsPanel
    atrStat = ta.atr(targetAtrLen)
    if not tradeLive and (longSignalFinal or shortSignalFinal)
        tradeLive    := true
        tradeDir     := longSignalFinal ? 1 : -1
        tradeEntry   := close
        tradeTarget  := tradeDir == 1 ? tradeEntry + atrStat * statsAtrMult : tradeEntry - atrStat * statsAtrMult
        tradeStop    := tradeDir == 1 ? tradeEntry - atrStat * statsAtrMult : tradeEntry + atrStat * statsAtrMult
        tradeBarsLeft := statsLookahead
    else if tradeLive
        tradeBarsLeft := tradeBarsLeft - 1
        hitTarget = tradeDir == 1 ? high >= tradeTarget : low <= tradeTarget
        hitStop   = tradeDir == 1 ? low <= tradeStop    : high >= tradeStop
        result = 0
        if hitStop and hitTarget
            result := -1  // در صورت لمس هر دو، محافظه‌کارانه استاپ را لحاظ می‌کنیم
        else if hitTarget
            result := 1
        else if hitStop
            result := -1
        else if tradeBarsLeft <= 0
            result := -1

        if result != 0
            if result == 1
                wins += 1
            else
                losses += 1
            tradeLive := false
            tradeDir := 0

// Coverage & stats table
var table infoTable = na
if na(infoTable) and (useCoverageGuard or showStatsPanel)
    infoTable := table.new(position.top_right, 1, 2)

if not na(infoTable)
    coverageText = useCoverageGuard ? "Coverage: " + str.tostring(coveragePct, "#.0") + "%" : ""
    totalTrades  = wins + losses
    winPct       = totalTrades > 0 ? (wins / totalTrades) * 100.0 : na
    statsText    = showStatsPanel ? "Wins: " + str.tostring(wins) + " | Losses: " + str.tostring(losses) + (not na(winPct) ? " | Win%: " + str.tostring(winPct, "#.0") + "%" : "") : ""
    table.cell(infoTable, 0, 0, coverageText, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 1, statsText, text_color=color.white, text_size=size.small)
